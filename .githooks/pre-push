#!/bin/sh
# Git Pre-Push Watchdog Hook for 'template' Branch Protection

current_branch=$(git branch --show-current)
protected_branch="template"

while read local_ref local_oid remote_ref remote_oid
do
    if [ "$remote_ref" = "refs/heads/$protected_branch" ] || [ "$current_branch" = "$protected_branch" ]; then
        echo "================================================================="
        echo "❌ ACCESS DENIED: Direct push to '$protected_branch' branch is forbidden!"
        echo "================================================================="
        echo "The '$protected_branch' branch is a frozen template."
        echo "Please create a practice branch before committing or pushing:"
        echo "  git checkout -b practice/your-topic-name"
        echo "================================================================="
        exit 1
    fi
done

exit 0
